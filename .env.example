# =============================================================================
# legal-medical-qa (MVP) -- settings template
#
# Copy to `.env` (or `.secrets`) and replace every <PLACEHOLDER>. Never commit the copy.
# Local-only secrets (database passwords, join-code pepper, session secret) are generated
# by `make setup` into `.secrets.generated`; you do not need to set them here.
# Values left as <PLACEHOLDER> are treated as unset.
# =============================================================================

# ---- General -------------------------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:3000        # must match the Auth0 callback / logout URLs below
LOG_LEVEL=INFO

# ---- Auth0 (blueprint 8): authentication only; roles live in PostgreSQL ----------------
# Dashboard, Applications > your "Regular Web Application":
#   Allowed Callback URLs:  http://localhost:3000/auth/callback
#   Allowed Logout URLs:    http://localhost:3000
#   Allowed Web Origins:    http://localhost:3000
# Dashboard, Applications > APIs: an API whose Identifier equals AUTH0_AUDIENCE_MAIN (RS256),
#   with "Allow Offline Access" on if you want refresh tokens.
AUTH0_DOMAIN=<your-tenant>.<region>.auth0.com
AUTH0_CLIENT_ID_BFF=<AUTH0_BFF_CLIENT_ID>
AUTH0_CLIENT_SECRET_BFF=<AUTH0_BFF_CLIENT_SECRET>
AUTH0_AUDIENCE_MAIN=https://api.onekami.site
AUTH0_CLAIMS_NAMESPACE=https://claims.onekami.site
# Optional, read-only use by `make doctor` to check the dashboard settings above
# (needs read:clients and read:resource_servers on the Management API):
AUTH0_M2M_CLIENT_ID=<AUTH0_M2M_CLIENT_ID>
AUTH0_M2M_CLIENT_SECRET=<AUTH0_M2M_CLIENT_SECRET>
# Optional: generated automatically if unset. openssl rand -hex 32
AUTH0_SESSION_SECRET=<RANDOM_64_HEX_CHARS>

# ---- Gemini (blueprint 11.8 provider boundary) -----------------------------------------
GEMINI_API_KEY=<GOOGLE_AI_STUDIO_KEY>
LLM_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded (HTTP 429/503) or times out.
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
LLM_THINKING_LEVEL=low                    # low | medium | high | off
LLM_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # 768 dimensions (fixed by the schema)
VERIFY_ENTAILMENT=on                      # second-pass entailment check (V6); on is recommended

# ---- RAG and limits ----------------------------------------------------------------------
RETRIEVAL_TOP_K=8
LLM_CONTEXT_BUDGET=12000                  # hard per-request token budget (blueprint 11.4)
UPLOAD_MAX_MB=25
QUERIES_PER_MINUTE=20

# ---- Local database (Docker; passwords come from .secrets.generated) ---------------------
LMQA_DB_HOST=localhost
LMQA_DB_PORT=5434
LMQA_DB_NAME=lmqa

# ---- Later stages (not read by the MVP; see docs/mvp.md) ---------------------------------
# AWS KMS / KeyGuard, Qdrant, Valkey, SeaweedFS, OpenBao, ClamAV, SMTP/IMAP, Cloudflare,
# on-call webhook, OpenTelemetry. The full catalog is in project-blueprint Appendix C.
