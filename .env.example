# Copy this file to .env and fill in real values before `make up`.
# No real secrets belong in this file or in git — this is documentation of
# what the stack needs, with safe local defaults.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=local                 # local | staging | production
LOG_LEVEL=INFO
APP_SECRET_KEY=  # used to sign internal JWTs locally

# Shared internal API key used for service-to-service calls in local mode.
# In production this is replaced by mTLS or signed service tokens (one-line swap).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_API_KEY=local-dev-internal-key

# ---------------------------------------------------------------------------
# Postgres (metadata, RBAC, audit log)
# ---------------------------------------------------------------------------
POSTGRES_USER=legalmed
POSTGRES_PASSWORD=legalmed
POSTGRES_DB=legalmed
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Column-level encryption key for PHI/privileged fields (libs/common/security).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=
# ---------------------------------------------------------------------------
# Redis (semantic cache, session state, rate-limit counters)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
SEMANTIC_CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Qdrant (vector DB)
# ---------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=legalmed_chunks

# ---------------------------------------------------------------------------
# MinIO (local S3-compatible object storage; swap to real S3/Azure Blob in prod)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=legalmed-documents
MINIO_ROOT_USER=legalmed
MINIO_ROOT_PASSWORD=legalmed123
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Auth (NextAuth/Auth.js locally; real IdP in prod)
# ---------------------------------------------------------------------------
AUTH_PROVIDER=local-credentials    # local-credentials | oidc-mock | okta | azure-ad
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-local-only-not-for-prod
# Only used when AUTH_PROVIDER=oidc-mock (local OIDC mock / test IdP)
OIDC_ISSUER_URL=http://localhost:9090
OIDC_CLIENT_ID=legalmed-local
OIDC_CLIENT_SECRET=local-dev-oidc-secret
JWT_ISSUER=legalmed-local
JWT_AUDIENCE=legalmed-services

# ---------------------------------------------------------------------------
# LLM provider (Generation service)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini              # anthropic | gemini | self-hosted | fake (fake = no real call, tests only)
LLM_API_KEY=your-google-api-key   #REQUIRED for anthropic/gemini — ignored for self-hosted/fake
LLM_MODEL=gemini-3.1-flash-lite       # e.g. claude-sonnet-4-6, gemini-2.5-flash, gemini-2.5-pro
LLM_SELF_HOSTED_BASE_URL=           # only used when LLM_PROVIDER=self-hosted
MAX_PROMPT_TOKENS=6000
MAX_COMPLETION_TOKENS=1024

# ---------------------------------------------------------------------------
# Embeddings + re-ranker (Ingestion / Retrieval)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=bge-large-en-v1.5
EMBEDDING_DEVICE=cpu                # cpu | cuda — CPU-friendly checkpoint by default locally
RERANKER_MODEL=bge-reranker-base
RERANKER_DEVICE=cpu
RETRIEVAL_TOP_K=40
RERANK_TOP_K=8

# ---------------------------------------------------------------------------
# OCR (Ingestion)
# ---------------------------------------------------------------------------
OCR_ENGINE=tesseract                 # tesseract | managed-api
OCR_LOW_CONFIDENCE_THRESHOLD=0.70    # pages below this are flagged for human review

# ---------------------------------------------------------------------------
# Prompt registry
# ---------------------------------------------------------------------------
PROMPT_REGISTRY_BACKEND=local-file   # local-file | promptlayer | langfuse
PROMPT_REGISTRY_API_KEY=

# ---------------------------------------------------------------------------
# Citation validation policy
# ---------------------------------------------------------------------------
CITATION_VALIDATION_POLICY=strip_unverified   # strip_unverified | regenerate
ENTAILMENT_SUPPORT_THRESHOLD=0.55

# ---------------------------------------------------------------------------
# Background jobs (Ingestion worker pool)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_QUEUE_BACKEND=redis           # redis | sqs

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=legalmed
ENABLE_TRACING=false


# ---------------------------------------------------------------------
# Optional: per-service Redis URLs. If unset, every service falls back to
# the shared REDIS_URL above (docker-compose default). Set these to give
# gateway/ingestion/generation independent logical caches, e.g. separate
# DB indices on the same Redis, or entirely separate Redis instances.
# ---------------------------------------------------------------------
GATEWAY_REDIS_URL=
INGESTION_REDIS_URL=
RETRIEVAL_REDIS_URL=
GENERATION_REDIS_URL=
CITATION_VALIDATOR_REDIS_URL=