# .env.example — All environment variables documented, no secrets
# Copy to .env for local development. NEVER commit .env.

# --- Auth0 Settings ---
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE_MAIN=https://api.lmqa.local/v1
AUTH0_AUDIENCE_ONBOARDING=https://onboard.lmqa.local/v1
AUTH0_CLIENT_ID_BFF=
AUTH0_CLIENT_SECRET_BFF=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_CLAIMS_NAMESPACE=https://lmqa.local/claims

# --- Database & PgBouncer ---
PG_USER=lmqa_admin
PG_PASSWORD=lmqa_secret
PG_HOST=localhost
PG_PORT=6432
PG_DATABASE=lmqa
# Service-scoped DSNs
PG_DSN_GATEWAY=postgresql+asyncpg://lmqa_gateway:secret@localhost:6432/lmqa
PG_DSN_IDENTITY=postgresql+asyncpg://lmqa_identity:secret@localhost:6432/lmqa
PG_DSN_INGESTION=postgresql+asyncpg://lmqa_ingestion:secret@localhost:6432/lmqa
PG_DSN_RETRIEVAL=postgresql+asyncpg://lmqa_retrieval:secret@localhost:6432/lmqa
PG_DSN_GENERATION=postgresql+asyncpg://lmqa_generation:secret@localhost:6432/lmqa
PG_DSN_VALIDATOR=postgresql+asyncpg://lmqa_validator:secret@localhost:6432/lmqa
PG_DSN_AUDIT=postgresql+asyncpg://lmqa_audit:secret@localhost:6432/lmqa
PG_DSN_OPS=postgresql+asyncpg://lmqa_ops:secret@localhost:6432/lmqa

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_KEY_RO=
QDRANT_KEY_RW=

# --- Cache & Sessions (Valkey) ---
VALKEY_URL=redis://localhost:6379/0

# --- Object Storage (AWS S3 per DR-16) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET_DOCUMENTS=lmqa-dev-documents
AWS_S3_BUCKET_AUDIT_ANCHORS=lmqa-dev-audit-anchors
AWS_S3_BUCKET_TOMBSTONES=lmqa-dev-tombstones
# IMDSv2 hop limit 1 enforced; credentials via environment or IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Key Management (AWS KMS / OpenBao) ---
KMS_PROVIDER=openbao
OPENBAO_URL=http://localhost:8200
OPENBAO_DEV_ROOT_TOKEN=root
KMS_ORG_KEY_ALIAS_PREFIX=alias/lmqa-org-
KMS_TRUST_ROOT_ID=

# --- Models & Spend Caps ---
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_BUDGET=high
GEMINI_API_KEY=
LLM_API_KEY_DEFAULT=
LLM_TEST_BUDGET_USD=0
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3
NLI_MODEL_HASH=

# --- Malware Scanning (ClamAV) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Email Notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=lmqa
