# =============================================================================
# legal-medical-qa  --  environment template (doc Appendix C, section 12.10)
#
# Copy to .env and replace every <PLACEHOLDER>. NEVER commit .env.
# Real secrets belong in the secret manager (AWS Secrets Manager) in production;
# this file documents every variable. Values below are placeholders only.
# =============================================================================

# ---- General ----------------------------------------------------------------
APP_ENV=local                       # local | ci | staging | production
PRODUCT_DOMAIN=onekami.site
APP_BASE_URL=http://localhost:3000  # production: https://onekami.site
API_BASE_URL=http://localhost:8000  # production: https://api.onekami.site
LOGIN_DOMAIN=login.onekami.site     # Auth0 custom domain (doc 8.1)
GATE_PROFILE=mvp                    # mvp | full (doc 19.6); only full is valid for production
LOG_LEVEL=INFO

# ---- Auth0 (doc section 8) ---------------------------------------------------
AUTH0_DOMAIN=<your-tenant>.<region>.auth0.com
AUTH0_AUDIENCE_MAIN=https://api.onekami.site
AUTH0_AUDIENCE_ONBOARDING=https://onboarding.onekami.site
AUTH0_CLIENT_ID_BFF=<AUTH0_BFF_CLIENT_ID>
AUTH0_CLIENT_SECRET_BFF=<AUTH0_BFF_CLIENT_SECRET>
AUTH0_CLAIMS_NAMESPACE=https://claims.onekami.site
# M2M credentials exist ONLY in the identity service environment (doc 8.8)
AUTH0_M2M_CLIENT_ID=<AUTH0_M2M_CLIENT_ID>
AUTH0_M2M_CLIENT_SECRET=<AUTH0_M2M_CLIENT_SECRET>
# Frontend session (server-side store; doc 8.3). Generate: openssl rand -hex 32
AUTH0_SESSION_SECRET=<RANDOM_64_HEX_CHARS>

# ---- PostgreSQL: one role per service (doc 9.2, 10.3) -------------------------
POSTGRES_SUPERUSER_PASSWORD=<POSTGRES_ADMIN_PASSWORD>   # local compose only
PG_MIGRATION_DSN=postgresql://lmqa_owner:<OWNER_PASSWORD>@localhost:5432/lmqa   # direct, never pooled
PG_DSN_GATEWAY=postgresql://svc_gateway:<GATEWAY_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_IDENTITY=postgresql://svc_identity:<IDENTITY_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_INGESTION=postgresql://svc_ingestion:<INGESTION_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_RETRIEVAL=postgresql://svc_retrieval:<RETRIEVAL_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_GENERATION=postgresql://svc_generation:<GENERATION_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_VALIDATOR=postgresql://svc_validator:<VALIDATOR_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_AUDIT=postgresql://svc_audit_reader:<AUDIT_DB_PASSWORD>@localhost:6432/lmqa
PG_DSN_OPS=postgresql://svc_ops:<OPS_DB_PASSWORD>@localhost:6432/lmqa
# Workers connect directly to PostgreSQL, not through the pooler (doc 10.3)
PG_DSN_WORKER=postgresql://svc_ingestion:<INGESTION_DB_PASSWORD>@localhost:5432/lmqa
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# ---- Qdrant (doc 10.5): read-only key for retrieval, read-write for ingestion --
QDRANT_URL=http://localhost:6333
QDRANT_KEY_RO=<QDRANT_READ_ONLY_KEY>
QDRANT_KEY_RW=<QDRANT_READ_WRITE_KEY>
QDRANT_COLLECTION_PREFIX=chunks

# ---- Valkey (ACL user per service; doc 9.2) -----------------------------------
VALKEY_URL=redis://localhost:6379
VALKEY_USER_FRONTEND=<VALKEY_FRONTEND_USER>
VALKEY_PASSWORD_FRONTEND=<VALKEY_FRONTEND_PASSWORD>
VALKEY_USER_GATEWAY=<VALKEY_GATEWAY_USER>
VALKEY_PASSWORD_GATEWAY=<VALKEY_GATEWAY_PASSWORD>
VALKEY_USER_IDENTITY=<VALKEY_IDENTITY_USER>
VALKEY_PASSWORD_IDENTITY=<VALKEY_IDENTITY_PASSWORD>
VALKEY_USER_RETRIEVAL=<VALKEY_RETRIEVAL_USER>
VALKEY_PASSWORD_RETRIEVAL=<VALKEY_RETRIEVAL_PASSWORD>
VALKEY_USER_GENERATION=<VALKEY_GENERATION_USER>
VALKEY_PASSWORD_GENERATION=<VALKEY_GENERATION_PASSWORD>

# ---- Object store (SeaweedFS locally, S3 in production; doc 12.3) -------------
OBJECT_STORE_ENDPOINT=http://localhost:8333
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=lmqa-documents
OBJECT_STORE_QUARANTINE_PREFIX=quarantine
OBJECT_STORE_CREDS_INGESTION_ACCESS_KEY=<OBJECT_STORE_ACCESS_KEY>
OBJECT_STORE_CREDS_INGESTION_SECRET_KEY=<OBJECT_STORE_SECRET_KEY>

# ---- AWS (production KMS, S3, ECS; doc 12, 4.6) --------------------------------
AWS_REGION=us-east-1
AWS_DR_REGION=us-west-2
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
AWS_VAULT_ACCOUNT_ID=<AWS_VAULT_ACCOUNT_ID>             # separate escrow account (doc 12.8)
# Local development only. CI and production use OIDC / IAM roles, never static keys.
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>

# ---- Keys (doc 12.1, 12.10) ---------------------------------------------------
KMS_PROVIDER=openbao                # openbao for local development; aws for staging and production
KMS_ORG_KEY_ALIAS_PREFIX=alias/lmqa/org
KMS_TRUST_ROOT_ID=<KMS_ASYMMETRIC_TRUST_ROOT_KEY_ID>    # ECC P-256 sign/verify (doc 9.1)
KMS_ESCROW_KEY_ID=<KMS_ESCROW_KEY_ID>
KEYGUARD_APPROVER_ROLE_ARN=<KEYGUARD_DESTROYER_ROLE_ARN>
KEYGUARD_ADMIN_ROLE_ARN=<KEY_ADMIN_ROLE_ARN>
CODE_PEPPER_ID=v1
CODE_PEPPER_V1=<RANDOM_64_HEX_CHARS>                    # secret manager in production (doc 7.6)
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=<OPENBAO_DEV_TOKEN>

# ---- Models (doc 11.8: provider chosen per organization) ----------------------
LLM_PROVIDER=anthropic              # anthropic | openai
LLM_MODEL=<LLM_MODEL_NAME>
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>
LLM_TEST_BUDGET_USD=5               # spend cap for live test lanes (doc 19.1 R9)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5      # MVP default (512-token chunks). Production candidate bge-m3 needs the Stage 4 bake-off first
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2    # MVP default. Production candidate bge-reranker-v2-m3 needs the Stage 5 bake-off first
NLI_MODEL=cross-encoder/nli-deberta-v3-small  # pinned by NLI_MODEL_HASH below
NLI_MODEL_HASH=<NLI_WEIGHTS_SHA256>                     # pinned weights hash (doc 11.6)
HF_TOKEN=<HUGGINGFACE_TOKEN>                            # only if a gated model is used

# ---- Mail (real mailbox on the project-owned domain; doc 19.1 R5) -------------
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=no-reply@onekami.site
IMAP_HOST=<IMAP_HOST>
IMAP_USER=<IMAP_USER>
IMAP_PASSWORD=<IMAP_PASSWORD>

# ---- Cloudflare (DNS, proxy, WAF, TLS for onekami.site) -----------------------
CLOUDFLARE_API_TOKEN=<CLOUDFLARE_API_TOKEN>             # scope: Zone.DNS edit + Zone.Zone WAF for onekami.site only
CLOUDFLARE_ZONE_ID=<CLOUDFLARE_ZONE_ID>
CLOUDFLARE_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>

# ---- Alerting and observability ------------------------------------------------
ONCALL_WEBHOOK_URL=<PAGER_WEBHOOK_URL>                  # real on-call channel (doc 13.6)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=lmqa

# ---- Service-to-service credentials (distinct per service; doc 9.2) -----------
SVC_SECRET_GATEWAY=<RANDOM_64_HEX_CHARS>
SVC_SECRET_IDENTITY=<RANDOM_64_HEX_CHARS>
SVC_SECRET_INGESTION=<RANDOM_64_HEX_CHARS>
SVC_SECRET_RETRIEVAL=<RANDOM_64_HEX_CHARS>
SVC_SECRET_GENERATION=<RANDOM_64_HEX_CHARS>
SVC_SECRET_VALIDATOR=<RANDOM_64_HEX_CHARS>
SVC_SECRET_AUDIT=<RANDOM_64_HEX_CHARS>
SVC_SECRET_OPS=<RANDOM_64_HEX_CHARS>

# ---- Gateway and internal service URLs (private network; doc 4.7) -------------------------------
GATEWAY_RESUME_KEY=<RANDOM_64_HEX_CHARS>                # 32 bytes; encrypts the 10-minute resume buffer
IDENTITY_URL=http://identity:8005
INGESTION_URL=http://ingestion:8001
RETRIEVAL_URL=http://retrieval:8002
GENERATION_URL=http://generation:8003
VALIDATOR_URL=http://citation-validator:8004
AUDIT_URL=http://audit:8007
TRUST_CLOUDFLARE=true                                   # trust CF-Connecting-IP (we sit behind Cloudflare)
RATE_LIMIT_PER_MINUTE=240
CONTRACTS_DIR=contracts
PROMPTS_DIR=prompts
OPENBAO_TRUST_ROOT_KEY=lmqa-trust-root
CLAMD_HOST=                                             # optional ClamAV daemon
ANSWER_CACHE=off                                        # on only for non-medical or opted-in organizations
LLM_MAX_OUTPUT=1500
LLM_CONTEXT_BUDGET=12000
NLI_THRESHOLD=                                          # a CALIBRATION RESULT (G7.3); do not guess
RERANK_THRESHOLD=                                       # a CALIBRATION RESULT (G5.11); do not guess

# ---- Database bootstrap (tools/db_migrate.py; the superuser is used only to create roles + the database)
POSTGRES_SUPERUSER_DSN=postgresql://postgres:<POSTGRES_ADMIN_PASSWORD>@localhost:5432/postgres
PGBOUNCER_AUTH_DSN=postgresql://pgbouncer_auth:<PGBOUNCER_AUTH_PASSWORD>@localhost:5432/lmqa
