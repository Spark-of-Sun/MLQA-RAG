{
  "components": {
    "schemas": {
      "AccessIn": {
        "description": "Change who can read a document.",
        "properties": {
          "matter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matter Id"
          },
          "tier": {
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Tier",
            "type": "integer"
          },
          "visibility": {
            "pattern": "^(private|matter)$",
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "visibility",
          "tier"
        ],
        "title": "AccessIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "UploadIn": {
        "description": "Start an upload: metadata and the SHA-256 the client must send.",
        "properties": {
          "declared_type": {
            "pattern": "^(pdf|docx|html|htm|xml|jats|spl|ecfr|txt)$",
            "title": "Declared Type",
            "type": "string"
          },
          "matter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matter Id"
          },
          "sha256_hex": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "title": "Sha256 Hex",
            "type": "string"
          },
          "tier": {
            "default": 1,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Tier",
            "type": "integer"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "visibility": {
            "pattern": "^(private|matter)$",
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "title",
          "visibility",
          "declared_type",
          "sha256_hex"
        ],
        "title": "UploadIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
