{
  "components": {
    "schemas": {
      "CodeIn": {
        "description": "A pasted code; the server normalizes and checks it.",
        "properties": {
          "code": {
            "maxLength": 200,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeIn",
        "type": "object"
      },
      "DecisionIn": {
        "description": "Optional grants applied at tenant approval.",
        "properties": {
          "grants": {
            "items": {
              "$ref": "#/components/schemas/GrantIn"
            },
            "title": "Grants",
            "type": "array"
          }
        },
        "title": "DecisionIn",
        "type": "object"
      },
      "GrantIn": {
        "description": "One matter grant with a tier ceiling and an optional expiry.",
        "properties": {
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "matter_id": {
            "format": "uuid",
            "title": "Matter Id",
            "type": "string"
          },
          "max_tier": {
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Max Tier",
            "type": "integer"
          }
        },
        "required": [
          "matter_id",
          "max_tier"
        ],
        "title": "GrantIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MatterIn": {
        "description": "A matter or patient scope.",
        "properties": {
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "type": {
            "default": "matter",
            "pattern": "^(matter|patient)$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "MatterIn",
        "type": "object"
      },
      "OrgIn": {
        "description": "Create an organization.",
        "properties": {
          "deployment_type": {
            "pattern": "^(legal|medical|both)$",
            "title": "Deployment Type",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "region": {
            "default": "us",
            "maxLength": 16,
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "name",
          "deployment_type"
        ],
        "title": "OrgIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WallIn": {
        "description": "An ethical wall.",
        "properties": {
          "matter_id": {
            "format": "uuid",
            "title": "Matter Id",
            "type": "string"
          },
          "reason_code": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Reason Code",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "matter_id",
          "reason_code"
        ],
        "title": "WallIn",
        "type": "object"
      }
    }
  },
