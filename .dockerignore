# Build context for infra/docker/service.Dockerfile (repo root). The image copies only pyproject.toml, uv.lock,
# libs/, services/, contracts/, prompts/, db/ and infra/keyguard/; everything else stays out of the context, above
# all settings files and local data.
.git
.env
.env.*
.secrets*
*.pem
*.key
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.hypothesis
.ruff_cache
.import_linter_cache
.coverage
data
corpus/data
frontend
agent_work
.kiro
gates
infra/auth0
infra/aws
*.zip
