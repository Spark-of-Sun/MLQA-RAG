{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmqa/contracts/state-machines.schema.json",
  "title": "Lifecycle state machines (blueprint 6, R-10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actors", "guards", "machines"],
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "names": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "glossary": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 10}
    }
  },
  "properties": {
    "version": {"const": 1},
    "actors": {"$ref": "#/$defs/glossary"},
    "guards": {"$ref": "#/$defs/glossary"},
    "machines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["states", "transitions"],
        "properties": {
          "bind": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^([a-z_]+\\.)?[a-z_]+\\.[a-z_]+$"}
          },
          "actor_check": {"type": "boolean"},
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "locked", "may_delete"],
            "properties": {
              "column": {"$ref": "#/$defs/name"},
              "locked": {"allOf": [{"$ref": "#/$defs/names"}, {"minItems": 1}]},
              "may_delete": {"$ref": "#/$defs/names"}
            }
          },
          "states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
          "transitions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "actors"],
              "properties": {
                "from": {"type": "string"},
                "to": {"type": "string"},
                "actors": {"allOf": [{"$ref": "#/$defs/names"}, {"minItems": 1}]},
                "guards": {"$ref": "#/$defs/names"},
                "effects": {"$ref": "#/$defs/names"},
                "workspace": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
