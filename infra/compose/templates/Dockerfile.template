# Base Dockerfile template for LMQA services
# Pinned by digest, non-root user, minimal attack surface

FROM python:3.14-alpine@sha256:d8b74619d084eeeb518349d970e5b7223b5d2c41680d7d91eeb1ea9dc6dcfb43 AS base

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv

# Create non-root system user
RUN addgroup -S -g 10001 lmqa && \
    adduser -S -u 10001 -G lmqa -h /home/lmqa -s /sbin/nologin lmqa

WORKDIR /app

# Change ownership to non-root user
RUN chown -R lmqa:lmqa /app

USER lmqa:lmqa

ENV PATH="/home/lmqa/.local/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

CMD ["python", "-m", "service"]
